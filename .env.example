# Copy to .env.local and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Supabase → Project Settings → API → service_role / secret key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (sandbox / test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Printed once by scripts/create-webhook.mjs (or by `stripe listen` when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_...
